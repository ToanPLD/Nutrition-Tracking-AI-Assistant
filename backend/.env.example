PORT=3000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/calai?schema=public"
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=NewPassword123!
DB_NAME=calai
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=your_email@gmail.com
JWT_SECRET=your_long_random_secret_here
JWT_EXPIRES_IN=7d

# CalAI Python Agent (Qdrant-backed, optional)
CAL_AI_BASE_URL=http://localhost:8000
# Vision pipeline can take 2-3 minutes when Qwen-VL needs to run; bump
# higher than the default 150000ms so users don't get spurious timeouts.
CAL_AI_VISION_TIMEOUT_MS=360000
CAL_AI_QUERY_TIMEOUT_MS=180000

# Ollama AI Configuration (fallback when CalAI unavailable)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qcwind/qwen2.5-7B-instruct-Q4_K_M
